{
  "custom-logger": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "AGY_EVENT='pre_invocation' /bin/sh '/Users/dwlhm/.gemini/config/hooks/log-hook.sh'",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "AGY_EVENT='post_invocation' /bin/sh '/Users/dwlhm/.gemini/config/hooks/log-hook.sh'",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "AGY_EVENT='stop' /bin/sh '/Users/dwlhm/.gemini/config/hooks/log-hook.sh'",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "AGY_EVENT='post_tool' /bin/sh '/Users/dwlhm/.gemini/config/hooks/log-hook.sh'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
