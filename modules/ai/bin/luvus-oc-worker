#!/bin/sh
# Luvus task worker: `luvus task start <id> --agent luvus-oc-worker` passes the full briefing as $1.
# Headless OpenCode (free DeepSeek) with edits allowed, network/code-exec denied, and shell limited
# to Luvus task reporting plus the project's own `check` gate scripts.
set -eu

: "${LUVUS_TASK_ID:?luvus-oc-worker must be launched by luvus task start}"
[ "$#" -eq 1 ] || { echo "usage: luvus-oc-worker <briefing>" >&2; exit 64; }

MODEL="${LUVUS_OC_MODEL:-opencode/deepseek-v4.1-flash-free}"

OPENCODE_CONFIG_CONTENT=$(cat <<EOF
{"model":"$MODEL","permission":{"edit":"allow","webfetch":"deny","execute":"deny",
 "bash":{"*":"deny","luvus task *":"allow","python3 */tests/check.py*":"allow","python3 tests/check.py*":"allow"}}}
EOF
)
export OPENCODE_CONFIG_CONTENT

exec opencode run --standalone --auto --title "$LUVUS_TASK_ID" "$1"
