open $QA_URL/#/beta/beta-reference.md
wait --fn "document.querySelector('h1#doc-title')?.textContent === 'Beta Reference'"
press /
wait --fn "document.activeElement?.id === 'search'"
fill "input#search" "zebra"
wait --fn "[...document.querySelectorAll('ul#results li a')].some(a => a.textContent.includes('Alpha Guide'))"
press Enter
wait --fn "document.querySelector('h1#doc-title')?.textContent === 'Alpha Guide'"
